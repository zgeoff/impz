{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "ESNext.TypedArrays"],
    "types": ["bun"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    // the shim stands in for the module whose declarations the published package has no use for
    "paths": {
      "@impz/testing/stand-in/start-test-impd": ["./testing/declarations/start-test-impd.d.ts"]
    }
  },
  "include": ["testing/src"],
  "exclude": ["**/*.test.ts", "testing/src/stand-in"]
}
