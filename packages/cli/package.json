  },
  "dependencies": {
    "@impz/api": "workspace:*",
    "@impz/client": "workspace:*",
    "@impz/local-tar": "workspace:*",
    "@impz/mcp": "workspace:*",
    "@impz/shared": "workspace:*",
    "gunshi": "catalog:",
    "p-retry": "catalog:",
    "ts-pattern": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "catalog:",
    "@impz/agent-protocol": "workspace:*",
    "@impz/daemon": "workspace:*",
