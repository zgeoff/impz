{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["bun", "vite/client", "@zgeoff/bun-test-extended"]
  },
  // the daemon's declaration for the shell scripts it imports as text, which
  // the tests reach through impd's testing entry
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "e2e/**/*.ts",
    "*.ts",
    "../daemon/src/shell-script.d.ts"
  ]
}
