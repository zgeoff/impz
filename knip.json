{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // protoc-gen-es is a plugin buf.gen.yaml runs
  "ignoreDependencies": [
    "@stylistic/eslint-plugin",
    "@zgeoff/oxlint-config",
    "@bufbuild/protoc-gen-es",
    // the synced skill-gate hook in .claude/ imports it, outside every project pattern
    "@zgeoff/skill-gate"
  ],
  // POSIX tools the tests run through Bun's shell, the Go toolchain's gofmt,
  // which the go:fmt-vet pre-push job runs, and the tools the Headscale test
  // runs inside its containers
  "ignoreBinaries": ["mkfifo", "gofmt", "apk", "headscale", "tailscale"],
  "workspaces": {
    ".": {
      // run-related-tests.ts is a synced CLI that test:related reaches through
      // run-branch-tests.ts; its other exports serve the tests in zgeoff/tools
      "entry": [
        "e2e/suites/*.e2e.ts",
        "scripts/ci/run-related-tests.ts",
        // the dev CLI that scripts/dev/dev.sh runs
        "scripts/dev/dev.ts",
        // the zfs harnesses that scripts/test-zfs.sh and scripts/zfs-host-test.sh run
        "scripts/test-zfs.ts",
        "scripts/zfs-host-test.ts",
        // a protoc plugin buf.gen.yaml runs
        "scripts/proto/protoc-gen-protocol-reference.ts"
      ],
      "project": [
        "e2e/**/*.ts",
        "scripts/**/*.ts",
        "deploy/**/*.ts",
        "host/**/*.ts",
        "kernel/**/*.ts",
        "*.test.ts"
      ]
    },
    "packages/*": {
      "project": ["src/**/*.ts!", "!src/test-utils/**!"]
    },
    "packages/daemon": {
      // impd, which host/Dockerfile compiles, the scripts a test runs in a
      // child Bun, and render:db-schema's dump
      "entry": [
        // a pattern ending in ! is production code for knip --production
        "src/main.ts!",
        "testing/*/run-*.ts",
        "src/platform/db/dump-schema.ts"
      ],
      "project": ["src/**/*.ts!", "testing/**/*.ts"],
      // kysely-codegen writes every table, used or not
      "ignoreIssues": {
        "src/platform/db/schema.ts": ["types"]
      }
    },
    "packages/agent-protocol": {
      "project": ["src/**/*.ts!", "!src/test-utils/**!"],
      // protoc-gen-es writes every message, used or not
      "ignoreIssues": {
        "src/gen/**": ["exports", "types"]
      }
    },
    "packages/dashboard": {
      "entry": ["augment-bun-test.ts", "e2e/*.e2e.ts"],
      "project": ["src/**/*.{ts,tsx}!", "!src/test-utils/**!", "e2e/**/*.ts"]
    },
    "packages/e2e-harness": {
      "project": ["src/**/*.ts"]
    },
    "packages/testing": {
      // the package smoke, which scripts/release/check-testing-package.sh runs installed
      "entry": ["smoke/*.ts"],
      "project": ["src/**/*.ts!", "smoke/*.ts"]
    },
    "packages/client": {
      // the package smoke (scripts/release/check-client-runtimes.sh), and
      // the scripts a test runs in a child Bun
      "entry": ["smoke/*.ts", "src/test-utils/run-*.ts"],
      "project": ["src/**/*.ts!", "!src/test-utils/**!", "smoke/*.ts"]
    }
  }
}
