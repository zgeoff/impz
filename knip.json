{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    "@stylistic/eslint-plugin",
    // the synced start-up stub in .claude/ imports it, outside every project pattern
    "@zgeoff/agent-hooks"
  ],
  // a POSIX tool the tests run through Bun's shell
  "ignoreBinaries": ["mkfifo"],
  // the Bun plugin takes its test files from a `bun test` script, and rig runs the root's tests
  "bun": { "entry": ["**/*.test.{ts,tsx}"] },
  // knip reads each piece of a Bun shell template between two interpolations as a command line of
  // its own, so it takes the arguments the CI and release step scripts and their stand-ins pass, and
  // the runner tools they call, for binaries, and Go's ./... package pattern and a shell script's
  // path for a file
  "ignoreIssues": {
    "scripts/{ci,release,test-utils}/**": ["binaries"],
    "scripts/ci/{run-go-checks,run-touched-pages-bench}.ts": ["unresolved"]
  },
  "workspaces": {
    ".": {
      "entry": [
        // rig loads its config, and a lane's start hook by the path the config names
        "rig.config.ts",
        "scripts/dev/prepare-docker-lane.ts",
        // the dev CLI that scripts/dev/dev.sh runs
        "scripts/dev/dev.ts",
        // the zfs harnesses that scripts/test-zfs.sh and scripts/zfs-host-test.sh run
        "scripts/test-zfs.ts",
        "scripts/zfs-host-test.ts"
      ],
      "project": [
        "scripts/**/*.ts",
        "deploy/**/*.ts",
        "host/**/*.ts",
        "kernel/**/*.ts",
        "*.test.ts"
      ]
    },
    "packages/*": {
      "project": ["src/**/*.ts!", "!src/test-utils/**!"]
    },
    "packages/daemon": {
      // impd, which host/Dockerfile compiles, the scripts a test runs in a
      // child Bun, render:db-schema's dump, and the bench scripts that
      // bench.yml and the dev container run
      "entry": [
        // a pattern ending in ! is production code for knip --production
        "src/main.ts!",
        "e2e/*.test.ts",
        "src/test-utils/*/run-*.ts",
        "src/platform/db/dump-schema.ts",
        "bench/*.ts"
      ],
      "project": ["src/**/*.ts!", "!src/test-utils/**!", "e2e/**/*.ts", "bench/**/*.ts"],
      // kysely-codegen writes every table, used or not
      "ignoreIssues": {
        "src/platform/db/schema.ts": ["types"]
      }
    },
    "packages/agent-protocol": {
      "project": ["src/**/*.ts!", "!src/test-utils/**!"],
      // protoc-gen-es writes every message, used or not
      "ignoreIssues": {
        "src/gen/**": ["exports", "types"]
      }
    },
    "packages/dashboard": {
      "entry": ["augment-bun-test.ts", "e2e/*.e2e.ts"],
      "project": ["src/**/*.{ts,tsx}!", "!src/test-utils/**!", "e2e/**/*.ts"]
    },
    "packages/e2e-harness": {
      "project": ["src/**/*.ts"]
    },
    "packages/testing": {
      // the package smoke, which scripts/release/check-testing-package.sh runs installed
      "entry": ["smoke/*.ts"],
      "project": ["src/**/*.ts!", "smoke/*.ts"]
    },
    "packages/client": {
      // the package smoke (scripts/release/check-client-runtimes.sh), and
      // the scripts a test runs in a child Bun
      "entry": ["smoke/*.ts", "src/test-utils/run-*.ts"],
      "project": ["src/**/*.ts!", "!src/test-utils/**!", "smoke/*.ts"]
    }
  }
}
