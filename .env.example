# Tailscale auth key: reusable, ephemeral, tagged (e.g. tag:imp). scripts/dev/dev.sh
# takes TAILSCALE_AUTHKEY from the env first, then (with IMP_TAILSCALE_OP=1) from
# 1Password with `op read "$IMP_TAILSCALE_AUTHKEY_REF"` (default impz's tag:imp-e2e
# client, op://$IMP_OP_VAULT/imp-e2e-tailscale-oauth/client-secret; 20 s limit), and
# only then from this file. impz names no vault: export IMP_OP_VAULT, the 1Password
# vault that holds the client, or the reference itself, or op is not asked.
# The e2e harness never uses this key: its tailnet suites join as tag:imp-e2e
# with their own OAuth client (docs/guides/configuration.md).
TAILSCALE_AUTHKEY=
