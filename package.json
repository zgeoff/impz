  "type": "module",
  "scripts": {
    "audit": "bun audit --ignore=GHSA-86w9-cpqp-85rv",
    "build:cli": "./scripts/release/build-cli.sh",
    "build:dashboard": "bun run --cwd packages/dashboard build",
    "deadcode": "knip && knip --production",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:full": "oxlint --type-aware --type-check --report-unused-disable-directives-severity error",
    "lint:docs": "bash .claude/skills/docs-writing/scripts/check-links.sh && bun scripts/ci/check-doc-citations.ts",
    "render:deploy": "bun scripts/render/render-imp-host.ts",
    "render:protocol": "bun scripts/render-protocol-schema.ts",
    "render:db-schema": "bun packages/daemon/src/platform/db/dump-schema.ts",
    "gen:proto": "buf lint && buf generate && oxfmt docs/reference/agent-protocol.md",
    "lint:shell": "./scripts/ci/shellcheck.sh",
    "test": "bun test",
    "check": "bun run check:static && bun test",
    "check:static": "bun run deadcode && bun run format:check && bun run lint:full && bun run lint:docs && bun run typecheck",
    "test:host": "bun test --timeout=15000 --path-ignore-patterns='packages/dashboard/**' .host.test.ts",
    "test:headscale": "bun test --timeout=15000 --path-ignore-patterns='packages/dashboard/**' .headscale.test.ts",
    "test:pebble": "bun scripts/dev/pull-pebble-images.ts && bun test --timeout=5000 --path-ignore-patterns='packages/dashboard/**' .pebble.test.ts",
    "test:docker": "bun test --timeout=15000 --path-ignore-patterns='packages/dashboard/**' .docker.test.ts",
    "test:small-fs": "bun test --timeout=15000 --path-ignore-patterns='packages/dashboard/**' .small-fs.test.ts",
    "test:dashboard": "bun run --cwd packages/dashboard test",
    "typecheck": "tsrs -p tsconfig.json --noEmit && tsrs -p packages/dashboard/tsconfig.json --noEmit",
    "format": "oxfmt . && format-codemod --quiet .",
    "format:check": "oxfmt --check . && format-codemod --check --quiet .",
    "prepare": "command -v git > /dev/null 2>&1 && lefthook install --force || true",
    "files:branch": "bun scripts/ci/read-branch-files.ts",
    "lint:files": "oxlint --no-error-on-unmatched-pattern",
    "test:related": "bun scripts/ci/run-branch-tests.ts"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.74.0",
