  "type": "module",
  "scripts": {
    "audit": "bun audit --ignore=GHSA-g3hv-75wg-m249",
    "build:cli": "./scripts/release/build-cli.sh",
    "build:dashboard": "bun run --cwd packages/dashboard build",
    "deadcode": "bash scripts/run-knip.sh && bash scripts/run-knip.sh --production",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:full": "tsgolint=$(tsrslint-path) && OXLINT_TSGOLINT_PATH=$tsgolint oxlint --type-aware --type-check --report-unused-disable-directives-severity error",
    "lint:docs": "chex links && bun scripts/ci/check-doc-citations.ts",
    "lint:formula": "bun scripts/release/check-formula-ruby.ts",
    "lint:images": "./scripts/ci/check-example-images.sh",
    "render:deploy": "bun scripts/render/render-imp-host.ts",
    "render:protocol": "bun scripts/render-protocol-schema.ts",
    "render:db-schema": "bun packages/daemon/src/platform/db/dump-schema.ts",
    "gen:proto": "buf lint && buf generate && oxfmt docs/reference/agent-protocol.md",
    "gen:uffd-stats": "bun scripts/render-uffd-stats-layout.ts",
    "lint:shell": "./scripts/ci/shellcheck.sh",
    "lint:workflows": "bun scripts/ci/check-release-jobs.ts",
    "test": "rig unit",
    "check": "bun run check:static && bun run test",
    "check:static": "bun run deadcode && bun run format:check && bun run lint:full && bun run lint:docs && bun run check:docs && bun run lint:formula && bun run lint:images && bun run lint:workflows && bun run typecheck",
    "test:host": "rig host",
    "test:headscale": "rig headscale",
    "test:pebble": "rig pebble",
    "test:docker": "rig docker",
    "test:small-fs": "rig small-fs",
    "test:dashboard": "bun run --cwd packages/dashboard test",
    "typecheck": "tsrs -p tsconfig.json --noEmit && tsrs -p packages/dashboard/tsconfig.json --noEmit",
    "format": "oxfmt . && format-codemod --quiet .",
    "format:check": "oxfmt --check . && format-codemod --check --quiet .",
    "prepare": "command -v git > /dev/null 2>&1 && lefthook install --force || true",
    "ci:set-up-runner": "bun scripts/ci/set-up-runner.ts",
    "ci:pick-data-dir": "bun scripts/ci/pick-data-dir.ts",
    "ci:collect-e2e-logs": "bun scripts/ci/collect-e2e-logs.ts",
    "ci:zfs-summary": "bun scripts/ci/write-zfs-summary.ts",
    "ci:small-fs-tests": "bun scripts/ci/run-small-fs-tests.ts",
    "ci:check-generated-protocol": "bun scripts/ci/check-generated-protocol.ts",
    "ci:check-embedded-shell": "bun scripts/ci/check-embedded-shell.ts",
    "ci:go": "bun scripts/ci/run-go-checks.ts",
    "ci:install-linter": "bun scripts/ci/install-linter.ts",
    "ci:check-workflows": "chex workflows",
    "ci:check-dependency-gates": "chex dependency-gates",
    "ci:touched-pages-bench": "bun scripts/ci/run-touched-pages-bench.ts",
    "release:plan-version": "bun scripts/release/plan-version.ts",
    "release:tree-script": "bun scripts/release/run-tree-script.ts",
    "release:check-cli-binary": "bun scripts/release/check-cli-binary.ts",
    "release:push-image": "bun scripts/release/push-image.ts",
    "release:plan-base-image": "bun scripts/release/plan-base-image.ts",
    "release:build-base-image": "bun scripts/release/build-base-image.ts",
    "release:tag-latest": "bun scripts/release/tag-latest.ts",
    "release:update-formula": "bun scripts/release/update-formula.ts",
    "release:plan-npm": "bun scripts/release/plan-npm-packages.ts",
    "release:pack-npm": "bun scripts/release/pack-npm-packages.ts",
    "check:docs": "chex prose length links readmes skill"
  },
