+// Throwaway bench harness: a guest that reads 100 MiB of its memory every
+// 200 ms, so a wake faults far more blocks than an idle guest's.
+const TOUCHER_SCRIPT =
+  'head -c 100M /dev/urandom > /dev/shm/blob && setsid nohup sh -c "while :; do cat /dev/shm/blob > /dev/null; sleep 0.2; done" > /dev/null 2>&1 &';
+
+async function startMemoryToucher(name: string): Promise<void> {
+  const started = Bun.spawn(['scripts/impz', 'exec', name, '--', 'sh', '-c', TOUCHER_SCRIPT], {
+    stdout: 'inherit',
+    stderr: 'inherit',
+  });
+
+  if ((await started.exited) !== 0) {
+    throw new Error(`the memory toucher in ${name} did not start`);
+  }
+}
