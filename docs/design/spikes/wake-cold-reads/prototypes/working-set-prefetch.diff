diff --git a/host/uffd-handler/workingset.go b/host/uffd-handler/workingset.go
new file mode 100644
index 00000000..55a916cb
--- /dev/null
+++ b/host/uffd-handler/workingset.go
@@ -0,0 +1,155 @@
+package main
+
+import (
+	"encoding/binary"
+	"io"
+	"os"
+	"sync"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+// Prototype: the working set is the list of 2 MiB data blocks that the guest
+// faulted in the first second of its last wake, in fault order. A wake reads
+// those blocks in parallel into buffers before the guest asks, and serves each
+// fault from its buffer; it records this wake's list for the next one.
+const (
+	workingSetBlock   = 2 << 20
+	workingSetReaders = 8
+	workingSetCap     = 1024
+	workingSetWindow  = time.Second
+)
+
+type prefetched struct {
+	offset int64
+	ready  chan struct{}
+	buf    []byte
+}
+
+type workingSet struct {
+	file     *os.File
+	blocks   map[int64]*prefetched
+	recorded map[int64]bool
+	count    int64
+	started  time.Time
+	released bool
+	wg       sync.WaitGroup
+}
+
+// openWorkingSet reads the last wake's list, starts the reads, and empties the
+// file for this wake's list.
+func openWorkingSet(path string, mem *os.File, memSize int64) (*workingSet, error) {
+	file, err := os.OpenFile(path, os.O_RDWR|os.O_CREATE, 0o600)
+	if err != nil {
+		return nil, err
+	}
+	raw, err := io.ReadAll(file)
+	if err != nil {
+		file.Close()
+		return nil, err
+	}
+	if err := file.Truncate(0); err != nil {
+		file.Close()
+		return nil, err
+	}
+	ws := &workingSet{file: file, blocks: map[int64]*prefetched{}, recorded: map[int64]bool{}}
+	var order []*prefetched
+	for i := 0; i+8 <= len(raw); i += 8 {
+		offset := int64(binary.LittleEndian.Uint64(raw[i:]))
+		if offset < 0 || offset%workingSetBlock != 0 || offset+workingSetBlock > memSize || ws.blocks[offset] != nil {
+			continue
+		}
+		block := &prefetched{offset: offset, ready: make(chan struct{})}
+		ws.blocks[offset] = block
+		order = append(order, block)
+	}
+	jobs := make(chan *prefetched, len(order))
+	for _, block := range order {
+		jobs <- block
+	}
+	close(jobs)
+	for range workingSetReaders {
+		ws.wg.Add(1)
+		go func() {
+			defer ws.wg.Done()
+			for block := range jobs {
+				block.read(mem)
+			}
+		}()
+	}
+	return ws, nil
+}
+
+func (block *prefetched) read(mem *os.File) {
+	defer close(block.ready)
+	buf, err := unix.Mmap(-1, 0, workingSetBlock, unix.PROT_READ|unix.PROT_WRITE, unix.MAP_PRIVATE|unix.MAP_ANONYMOUS)
+	if err != nil {
+		return
+	}
+	if _, err := mem.ReadAt(buf, block.offset); err != nil {
+		_ = unix.Munmap(buf)
+		return
+	}
+	block.buf = buf
+}
+
+// take returns the block's buffer once its read ends, or nil when the last
+// wake did not touch it or its read failed.
+func (ws *workingSet) take(offset int64) []byte {
+	if ws == nil || ws.released {
+		return nil
+	}
+	block := ws.blocks[offset]
+	if block == nil {
+		return nil
+	}
+	<-block.ready
+	return block.buf
+}
+
+// served frees the block's buffer and records the block, in the window.
+func (ws *workingSet) served(offset int64) {
+	if ws == nil {
+		return
+	}
+	if block := ws.blocks[offset]; block != nil && !ws.released {
+		<-block.ready
+		if block.buf != nil {
+			_ = unix.Munmap(block.buf)
+		}
+		delete(ws.blocks, offset)
+	}
+	now := time.Now()
+	if ws.started.IsZero() {
+		ws.started = now
+	}
+	if now.Sub(ws.started) > workingSetWindow {
+		ws.release()
+		return
+	}
+	if ws.recorded[offset] || ws.count >= workingSetCap {
+		return
+	}
+	var entry [8]byte
+	binary.LittleEndian.PutUint64(entry[:], uint64(offset))
+	if _, err := ws.file.WriteAt(entry[:], ws.count*8); err == nil {
+		ws.recorded[offset] = true
+		ws.count++
+	}
+}
+
+// release frees the buffers of blocks this wake never touched.
+func (ws *workingSet) release() {
+	if ws.released {
+		return
+	}
+	ws.released = true
+	ws.wg.Wait()
+	for offset, block := range ws.blocks {
+		if block.buf != nil {
+			_ = unix.Munmap(block.buf)
+		}
+		delete(ws.blocks, offset)
+	}
+}
