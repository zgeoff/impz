+// Throwaway bench harness: with BENCH_EVICT=1, drop every sleeping imp's memory
+// file from the page cache before a timed wake, so the wake reads it cold. It
+// prints each memory file's data and working set, for the RAM cost.
+const EVICT_SCRIPT = `
+for f in $(find $(findmnt -t xfs -n -o TARGET) -path '*/snapshot/mem' -type f); do
+  if [ "$BENCH_EVICT" = 1 ]; then
+    dd if=/dev/null of="$f" oflag=nocache conv=notrunc,fdatasync count=0 status=none
+  fi
+  ws="$(dirname "$f")/working-set"
+  echo "bench-evict mem_kib=$(du -k "$f" | cut -f1) ws_bytes=$(stat -c %s "$ws" 2>/dev/null || echo 0)" >&2
+done
+`;
+
+async function evictMemFiles(): Promise<void> {
+  if (process.env['BENCH_EVICT'] === undefined) {
+    return;
+  }
+
+  const shell = Bun.spawn(
+    [
+      'docker',
+      'exec',
+      '-i',
+      '-e',
+      `BENCH_EVICT=${process.env['BENCH_EVICT']}`,
+      'imp-dev',
+      'sh',
+      '-s',
+    ],
+    { stdin: new TextEncoder().encode(EVICT_SCRIPT), stdout: 'inherit', stderr: 'pipe' },
+  );
+
+  const sizes = await new Response(shell.stderr).text();
+
+  await shell.exited;
+
+  mkdirSync('.cache/bench', { recursive: true });
+  appendFileSync('.cache/bench/evict.log', sizes);
+
+  if (process.env['BENCH_EVICT'] !== '1') {
+    return;
+  }
+
+  const dropped = Bun.spawn(['sudo', 'sh', '-c', 'sync && echo 1 > /proc/sys/vm/drop_caches'], {
+    stdout: 'inherit',
+    stderr: 'inherit',
+  });
+
+  await dropped.exited;
+}
+
