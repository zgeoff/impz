diff --git a/host/uffd-handler/warm.go b/host/uffd-handler/warm.go
new file mode 100644
index 00000000..0bf36a72
--- /dev/null
+++ b/host/uffd-handler/warm.go
@@ -0,0 +1,35 @@
+package main
+
+import (
+	"fmt"
+	"os"
+)
+
+// Prototype: warmMemFile reads each 2 MiB block of the memory file that holds
+// data through a map of the file, so the page cache holds it at the next wake.
+func warmMemFile(path string) error {
+	file, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	source, err := openMemSource(file)
+	if err != nil {
+		return err
+	}
+	defer source.close()
+	data, err := source.readDataPages(workingSetBlock)
+	if err != nil {
+		return err
+	}
+	var sum byte
+	for offset := range data {
+		end := min(offset+workingSetBlock, int64(len(source.mapped)))
+		for page := offset; page < end; page += 4096 {
+			sum += source.mapped[page]
+		}
+	}
+	fmt.Fprintf(os.Stderr, "uffd-handler: warmed %d blocks (%d)\n", len(data), sum)
+	return nil
+}
+
+const workingSetBlock = 2 << 20
