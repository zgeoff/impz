{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@zgeoff/oxlint-config/oxlintrc.json"],
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    "zgeoff/function-verb": [
      "error",
      {
        "exemptNames": [
          // kysely's DatabaseConnection interface, which the bun:sqlite driver's
          // connection implements
          "executeQuery",
          // the MCP SDK's OAuthClientProvider interface
          "saveTokens",
          "saveCodeVerifier",
          "saveDiscoveryState",
          // Node's EventEmitter method, which the stand-ins for process and
          // stdin implement
          "on"
        ]
      }
    ],
    // zod's documented import form is `import * as z from 'zod'`
    "import/no-namespace": "off",
    // off until GEO-1199 trims the functions that take more than 4 parameters
    "max-params": "off",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@impz/*/src", "@impz/*/src/**", "**/packages/*/**"],
            "message": "import a package by its name and an entry its package.json exports, never its files by path"
          }
        ]
      }
    ],
    // the package boundaries: a package imports only the packages below it, by name, and
    // production code imports no test support
    "zgeoff/import-zones": [
      "error",
      {
        "zones": {
          "packages": ["packages/**"],
          "shared": ["packages/shared/**"],
          "agent-protocol": ["packages/agent-protocol/**"],
          "client": ["packages/client/**"],
          "above-client": ["packages/{mcp,cli,daemon,dashboard}/**"],
          "test-utils": ["packages/test-utils/**"],
          "runtime-neutral": ["packages/{shared,agent-protocol,api,client}/**"],
          // the daemon's own test helpers build queries against real databases
          "db": ["packages/daemon/src/platform/db/**", "packages/daemon/testing/**"],
          "tests": [
            "**/*.{test,e2e,pebble}.{ts,tsx}",
            "**/{test-utils,smoke,mocks}/**",
            "packages/daemon/testing/**",
            "packages/dashboard/e2e/**",
            "**/test-setup.ts"
          ],
          // impd's layers from the bottom up, and the composition root's files above them all
          "daemon-src": ["packages/daemon/src/**"],
          "daemon-root": ["packages/daemon/src/*.ts"],
          // the version that the system routes and the MCP endpoint report
          "daemon-manifest": ["packages/daemon/package.json"],
          "daemon-platform": ["packages/daemon/src/platform/**"],
          "daemon-host-net": ["packages/daemon/src/host-net/**"],
          "daemon-vm": ["packages/daemon/src/vm/**"],
          "daemon-imps": ["packages/daemon/src/imps/**"],
          "daemon-network": ["packages/daemon/src/network/**"],
          "daemon-identity": ["packages/daemon/src/identity/**"],
          "daemon-imp-ops": ["packages/daemon/src/imp-ops/**"],
          "daemon-surface": ["packages/daemon/src/surface/**"],
          "daemon-below-surface": [
            "packages/daemon/src/{platform,host-net,vm,imps,network,identity,imp-ops}/**"
          ]
        },
        "edges": [
          {
            "name": "package-by-name",
            "from": ["packages"],
            "to": ["packages"],
            "allowWithin": "packages/*",
            "reason": "import another package by its package name, never by a relative path"
          },
          {
            "name": "test-support",
            "from": ["packages"],
            "to": ["tests"],
            "ignore": [
              "**/*.{test,e2e,pebble}.{ts,tsx}",
              "**/{test-utils,smoke,mocks}/**",
              "packages/daemon/testing/**",
              "packages/dashboard/e2e/**",
              "**/test-setup.ts"
            ],
            "reason": "production code never imports test support"
          },
          {
            "name": "daemon-layer-platform",
            "from": ["daemon-platform"],
            "ignore": [
              "**/*.{test,e2e,pebble}.{ts,tsx}",
              "**/{test-utils,smoke,mocks}/**",
              "**/test-setup.ts"
            ],
            "allow": ["daemon-platform"],
            // the Config type until each layer owns its config slice (GEO-364)
            "allowTypeOnly": ["packages/daemon/src/config.ts"],
            "reason": "a daemon layer imports only itself and the layers below it: platform, host-net, vm, imps, network, identity, imp-ops, surface"
          },
          {
            "name": "daemon-layer-host-net",
            "from": ["daemon-host-net"],
            "ignore": [
              "**/*.{test,e2e,pebble}.{ts,tsx}",
              "**/{test-utils,smoke,mocks}/**",
              "**/test-setup.ts"
            ],
            "allow": ["daemon-platform", "daemon-host-net"],
            // the Config type until each layer owns its config slice (GEO-364)
            "allowTypeOnly": ["packages/daemon/src/config.ts"],
            "reason": "a daemon layer imports only itself and the layers below it: platform, host-net, vm, imps, network, identity, imp-ops, surface"
          },
          {
            "name": "daemon-layer-vm",
            "from": ["daemon-vm"],
            "ignore": [
              "**/*.{test,e2e,pebble}.{ts,tsx}",
              "**/{test-utils,smoke,mocks}/**",
              "**/test-setup.ts"
            ],
            "allow": ["daemon-platform", "daemon-host-net", "daemon-vm"],
            // the Config type until each layer owns its config slice (GEO-364)
            "allowTypeOnly": ["packages/daemon/src/config.ts"],
            "reason": "a daemon layer imports only itself and the layers below it: platform, host-net, vm, imps, network, identity, imp-ops, surface"
          },
          {
            "name": "daemon-layer-imps",
            "from": ["daemon-imps"],
            "ignore": [
              // imp-docker-proxy's composition root, as main.ts is impd's
              "packages/daemon/src/imps/docker-proxy/main.ts",
              "**/*.{test,e2e,pebble}.{ts,tsx}",
              "**/{test-utils,smoke,mocks}/**",
              "**/test-setup.ts"
            ],
            "allow": ["daemon-platform", "daemon-host-net", "daemon-vm", "daemon-imps"],
            // the Config type until each layer owns its config slice (GEO-364)
            "allowTypeOnly": ["packages/daemon/src/config.ts"],
            "reason": "a daemon layer imports only itself and the layers below it: platform, host-net, vm, imps, network, identity, imp-ops, surface"
          },
          {
            "name": "daemon-layer-network",
            "from": ["daemon-network"],
            "ignore": [
              "**/*.{test,e2e,pebble}.{ts,tsx}",
              "**/{test-utils,smoke,mocks}/**",
              "**/test-setup.ts"
            ],
            "allow": [
              "daemon-platform",
              "daemon-host-net",
              "daemon-vm",
              "daemon-imps",
              "daemon-network"
            ],
            // the Config type until each layer owns its config slice (GEO-364)
            "allowTypeOnly": ["packages/daemon/src/config.ts"],
            "reason": "a daemon layer imports only itself and the layers below it: platform, host-net, vm, imps, network, identity, imp-ops, surface"
          },
          {
            "name": "daemon-layer-identity",
            "from": ["daemon-identity"],
            "ignore": [
              "**/*.{test,e2e,pebble}.{ts,tsx}",
              "**/{test-utils,smoke,mocks}/**",
              "**/test-setup.ts"
            ],
            "allow": [
              "daemon-platform",
              "daemon-host-net",
              "daemon-vm",
              "daemon-imps",
              "daemon-network",
              "daemon-identity"
            ],
            // the Config type until each layer owns its config slice (GEO-364)
            "allowTypeOnly": ["packages/daemon/src/config.ts"],
            "reason": "a daemon layer imports only itself and the layers below it: platform, host-net, vm, imps, network, identity, imp-ops, surface"
          },
          {
            "name": "daemon-layer-imp-ops",
            "from": ["daemon-imp-ops"],
            "ignore": [
              "**/*.{test,e2e,pebble}.{ts,tsx}",
              "**/{test-utils,smoke,mocks}/**",
              "**/test-setup.ts"
            ],
            "allow": [
              "daemon-platform",
              "daemon-host-net",
              "daemon-vm",
              "daemon-imps",
              "daemon-network",
              "daemon-identity",
              "daemon-imp-ops"
            ],
            // the Config type until each layer owns its config slice (GEO-364)
            "allowTypeOnly": ["packages/daemon/src/config.ts"],
            "reason": "a daemon layer imports only itself and the layers below it: platform, host-net, vm, imps, network, identity, imp-ops, surface"
          },
          {
            "name": "daemon-layer-surface",
            "from": ["daemon-surface"],
            "ignore": [
              "**/*.{test,e2e,pebble}.{ts,tsx}",
              "**/{test-utils,smoke,mocks}/**",
              "**/test-setup.ts"
            ],
            "allow": [
              "daemon-platform",
              "daemon-host-net",
              "daemon-vm",
              "daemon-imps",
              "daemon-network",
              "daemon-identity",
              "daemon-imp-ops",
              "daemon-surface",
              "daemon-manifest"
            ],
            // the Config type until each layer owns its config slice (GEO-364)
            "allowTypeOnly": ["packages/daemon/src/config.ts"],
            "reason": "a daemon layer imports only itself and the layers below it: platform, host-net, vm, imps, network, identity, imp-ops, surface"
          }
        ],
        "unzoned": [
          {
            "name": "daemon-layer-folder",
            "from": ["daemon-src"],
            "zones": [
              "daemon-root",
              "daemon-platform",
              "daemon-host-net",
              "daemon-vm",
              "daemon-imps",
              "daemon-network",
              "daemon-identity",
              "daemon-imp-ops",
              "daemon-surface"
            ],
            "reason": "a daemon file sits in a layer folder, or at the top of src as part of the composition root"
          }
        ],
        "modules": [
          {
            "name": "orpc-in-surface",
            "modules": ["@orpc/server", "@orpc/client"],
            "from": ["daemon-below-surface"],
            "ignore": [
              "**/*.{test,e2e,pebble}.{ts,tsx}",
              "**/{test-utils,smoke,mocks}/**",
              "**/test-setup.ts"
            ],
            "allow": ["daemon-surface"],
            "reason": "only surface speaks oRPC: a lower layer throws its own error, and surface maps it to an ORPCError"
          },
          {
            "name": "kysely",
            "modules": ["kysely", "kysely-codegen"],
            "from": ["packages"],
            "allow": ["db"],
            "reason": "query through a repository in packages/daemon/src/platform/db instead"
          },
          {
            "name": "test-support",
            "modules": [
              "@impz/test-utils",
              "@impz/api/test-utils",
              "@impz/client/test-utils",
              "@impz/daemon/testing"
            ],
            "from": ["packages"],
            "allow": ["tests"],
            "reason": "production code never imports test support"
          },
          {
            "name": "runtime-neutral",
            "modules": ["node:*"],
            "from": ["runtime-neutral"],
            "allow": ["tests"],
            "reason": "@impz/shared, @impz/agent-protocol, @impz/api and the client run in any runtime"
          },
          {
            "name": "package-order",
            "modules": ["@impz/*"],
            "from": ["shared"],
            "allow": ["tests"],
            "reason": "@impz/shared imports no @impz/* package"
          },
          {
            "name": "package-order",
            "modules": ["@impz/*"],
            "from": ["agent-protocol"],
            "allow": ["tests"],
            "reason": "@impz/agent-protocol imports no @impz/* package"
          },
          {
            "name": "package-order",
            "modules": ["@impz/agent-protocol"],
            "from": ["packages"],
            "allow": ["daemon-src", "tests"],
            "reason": "only impd speaks the agent protocol; another package imports @impz/agent-protocol only in its tests"
          },
          {
            "name": "package-order",
            "modules": ["@impz/api"],
            "from": ["packages"],
            "allow": ["client", "above-client", "tests"],
            "reason": "only the client, @impz/mcp and the apps import @impz/api"
          },
          {
            "name": "package-order",
            "modules": ["@impz/local-tar", "@impz/client", "@impz/mcp"],
            "from": ["packages"],
            "allow": ["above-client", "tests"],
            "reason": "only @impz/mcp and the apps import @impz/local-tar, the client and @impz/mcp"
          },
          {
            "name": "package-order",
            "modules": ["@impz/cli", "@impz/daemon", "@impz/dashboard"],
            "from": ["packages"],
            "allow": ["tests"],
            "reason": "an app imports no other app"
          },
          {
            "name": "package-order",
            "modules": [
              "@impz/agent-protocol",
              "@impz/local-tar",
              "@impz/api",
              "@impz/client",
              "@impz/mcp",
              "@impz/cli",
              "@impz/daemon",
              "@impz/dashboard"
            ],
            "from": ["test-utils"],
            "allow": ["daemon-surface"],
            "reason": "@impz/test-utils is a leaf: it imports only @impz/shared"
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      // the web dashboard: React in a browser
      "files": ["packages/dashboard/**"],
      "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "react", "jsx-a11y"],
      "env": { "browser": true },
      "rules": {
        // React 19's JSX runtime needs no React in scope
        "react/react-in-jsx-scope": "off",
        "react/jsx-props-no-spreading": "off",
        "react/jsx-max-depth": "off",
        // stylesheets are imported for their side effect
        "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }]
      }
    },
    {
      // the daemon's stand-in for the VM runner answers a whole contract in one
      // module, so its line count runs past the limit
      "files": ["packages/daemon/testing/vm/build-stub-vmm.ts"],
      "rules": { "max-lines": "off" }
    },
    {
      // the client's and the MCP server's tests against a real impd sit downstream of the
      // daemon, away from the modules they test, so no package depends on the daemon that
      // depends on it
      "files": ["packages/integration/**"],
      "rules": { "zgeoff/test-beside-module": "off" }
    },
    {
      // the cli keeps every error that main.ts maps to an exit code in one module
      "files": ["packages/cli/src/cli/errors.ts"],
      "rules": { "max-classes-per-file": "off" }
    }
  ],
  // .claude/** holds the skill-gate hook, which repo-sync delivers from
  // zgeoff/tools: a fix lands upstream, never here
  "ignorePatterns": [
    ".claude/**",
    ".cache/**",
    "kernel/**",
    "agent/**",
    // protoc-gen-es output (bun run gen:proto)
    "packages/agent-protocol/src/gen/**"
  ]
}
