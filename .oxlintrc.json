        "unzoned": [
          {
            "name": "daemon-layer-folder",
            "from": ["daemon-src"],
            "zones": [
              "daemon-root",
              "daemon-platform",
              "daemon-host-net",
              "daemon-vm",
              "daemon-imps",
              "daemon-network",
              "daemon-identity",
              "daemon-imp-ops",
              "daemon-surface"
            ],
            "reason": "a daemon file sits in a layer folder, or at the top of src as part of the composition root"
          },
          {
            "name": "daemon-vm-folder",
