              "daemon-host-net",
              "daemon-vm",
              "daemon-imps",
              "daemon-network",
              "daemon-identity",
              "daemon-imp-ops"
            ],
            "reason": "a daemon layer imports only itself and the layers below it: platform, host-net, vm, imps, network, identity, imp-ops, surface"
