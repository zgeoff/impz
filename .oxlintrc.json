{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@zgeoff/oxlint-config/oxlintrc.json"],
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    // the shared options, plus `v`: the version field of the event envelope's
    // wire format and of the broker's OAuth state file
    "id-length": [
      "error",
      { "min": 2, "exceptions": ["x", "y", "z", "$", "_", "v"], "checkGeneric": false }
    ],
    "zgeoff/function-verb": [
      "error",
      {
        "exemptNames": [
          // the WHATWG fetch signature: Bun.serve's handler and the fetch
          // option that @impz/client takes
          "fetch",
          // kysely's DatabaseConnection interface, which the bun:sqlite driver's
          // connection implements
          "executeQuery",
          // the MCP SDK's OAuthClientProvider interface
          "saveTokens",
          "saveCodeVerifier",
          "saveDiscoveryState",
          // Node's EventEmitter method, which the stand-ins for process and
          // stdin implement
          "on"
        ]
      }
    ],
    // zod's documented import form is `import * as z from 'zod'`
    "import/no-namespace": "off",
    // off until GEO-1199 trims the functions that take more than 4 parameters
    "max-params": "off",
    // the package boundaries: a package imports only the packages below it, by name, and
    // production code imports no test support
    "zgeoff/import-zones": [
      "error",
      {
        "zones": {
          "packages": ["packages/**"],
          "shared": ["packages/shared/**"],
          "client": ["packages/client/**"],
          "above-client": ["packages/{mcp,cli,daemon,dashboard}/**"],
          "test-utils": ["packages/test-utils/**"],
          "runtime-neutral": ["packages/{shared,api,client}/**"],
          // the daemon's own test helpers build queries against real databases
          "db": ["packages/daemon/src/{db,test-utils}/**"],
          "tests": [
            "**/*.{test,e2e,pebble}.{ts,tsx}",
            "**/{test-utils,smoke,mocks}/**",
            "packages/dashboard/e2e/**",
            "**/test-setup.ts"
          ]
        },
        "edges": [
          {
            "name": "package-by-name",
            "from": ["packages"],
            "to": ["packages"],
            // a test may reach another package's helpers, which no package exports, by path
            "allow": ["tests"],
            "allowWithin": "packages/*",
            "reason": "import another package by its package name, never by a relative path"
          },
          {
            "name": "test-support",
            "from": ["packages"],
            "to": ["tests"],
            "ignore": [
              "**/*.{test,e2e,pebble}.{ts,tsx}",
              "**/{test-utils,smoke,mocks}/**",
              "packages/dashboard/e2e/**",
              "**/test-setup.ts"
            ],
            "reason": "production code never imports test support"
          }
        ],
        "modules": [
          {
            "name": "kysely",
            "modules": ["kysely", "kysely-codegen"],
            "from": ["packages"],
            "allow": ["db"],
            "reason": "query through a repository in packages/daemon/src/db instead"
          },
          {
            "name": "test-support",
            "modules": ["@impz/test-utils", "@impz/api/test-utils", "@impz/client/test-utils"],
            "from": ["packages"],
            "allow": ["tests"],
            "reason": "production code never imports test support"
          },
          {
            "name": "runtime-neutral",
            "modules": ["node:*"],
            "from": ["runtime-neutral"],
            "allow": ["tests"],
            "reason": "@impz/shared, @impz/api and the client run in any runtime"
          },
          {
            "name": "package-order",
            "modules": ["@impz/*"],
            "from": ["shared"],
            "allow": ["tests"],
            "reason": "@impz/shared imports no @impz/* package"
          },
          {
            "name": "package-order",
            "modules": ["@impz/api"],
            "from": ["packages"],
            "allow": ["client", "above-client", "tests"],
            "reason": "only the client, @impz/mcp and the apps import @impz/api"
          },
          {
            "name": "package-order",
            "modules": ["@impz/local-tar", "@impz/client", "@impz/mcp"],
            "from": ["packages"],
            "allow": ["above-client", "tests"],
            "reason": "only @impz/mcp and the apps import @impz/local-tar, the client and @impz/mcp"
          },
          {
            "name": "package-order",
            "modules": ["@impz/cli", "@impz/daemon", "@impz/dashboard"],
            "from": ["packages"],
            "allow": ["tests"],
            "reason": "an app imports no other app"
          },
          {
            "name": "package-order",
            "modules": [
              "@impz/local-tar",
              "@impz/api",
              "@impz/client",
              "@impz/mcp",
              "@impz/cli",
              "@impz/daemon",
              "@impz/dashboard"
            ],
            "from": ["test-utils"],
            "allow": [],
            "reason": "@impz/test-utils is a leaf: it imports only @impz/shared"
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      // the web dashboard: React in a browser
      "files": ["packages/dashboard/**"],
      "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "react", "jsx-a11y"],
      "env": { "browser": true },
      "rules": {
        // React 19's JSX runtime needs no React in scope
        "react/react-in-jsx-scope": "off",
        "react/jsx-props-no-spreading": "off",
        "react/jsx-max-depth": "off",
        // stylesheets are imported for their side effect
        "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }]
      }
    },
    {
      // the dashboard's stand-in for impd's router and the daemon's stand-in
      // for the VM runner each answer a whole contract in one module, so their
      // line counts run past the limit
      "files": [
        "packages/dashboard/src/mocks/impd-router.ts",
        "packages/daemon/src/test-utils/build-stub-vmm.ts"
      ],
      "rules": { "max-lines": "off" }
    },
    {
      // the cli keeps every error that main.ts maps to an exit code in one module
      "files": ["packages/cli/src/cli/errors.ts"],
      "rules": { "max-classes-per-file": "off" }
    }
  ],
  // .claude/** holds the skill-gate hook, which repo-sync delivers from
  // zgeoff/tools: a fix lands upstream, never here
  "ignorePatterns": [
    ".claude/**",
    ".cache/**",
    "kernel/**",
    "agent/**",
    // protoc-gen-es output (bun run gen:proto)
    "packages/daemon/src/agent-client/gen/**"
  ]
}
