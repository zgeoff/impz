{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@zgeoff/oxlint-config/oxlintrc.json"],
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    "zgeoff/function-verb": [
      "error",
      {
        "exemptNames": [
          // the MCP SDK's OAuthClientProvider interface
          "saveTokens",
          "saveCodeVerifier",
          "saveDiscoveryState",
          // Node's EventEmitter method, which the stand-ins for process and
          // stdin implement
          "on"
        ]
      }
    ],
    // each lane's per-test limit, as the project-testing skill's Lanes table states; `e2e/`
    // holds both the VM and the ZFS lanes
    "zgeoff/max-test-timeout": [
      "error",
      {
        "lanes": {
          "e2e": 60000,
          "host": 15000,
          "headscale": 15000,
          "pebble": 5000,
          "docker": 15000,
          "small-fs": 15000
        }
      }
    ],
    "zgeoff/test-beside-module": [
      "error",
      {
        "lanes": {
          "e2e": 60000,
          "host": 15000,
          "headscale": 15000,
          "pebble": 5000,
          "docker": 15000,
          "small-fs": 15000
        }
      }
    ],
    // the shared cast ban stays off until the repo's casts go, and the lock that refuses this
    // setting goes with it; GEO-1468's PRs for impz remove the casts and turn all three back on
    "typescript/consistent-type-assertions": "off",
    "zgeoff/no-hidden-cast": "off",
    "zgeoff/no-comment-rule-override": "off",
    // each library's docs import it as one object; an option set here replaces the shared ignore
    // list, so this list names zod again
    "import/no-namespace": [
      "error",
      { "ignore": ["zod", "zod/*", "dns-packet", "@peculiar/x509", "acme-client"] }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@impz/*/src", "@impz/*/src/**", "**/packages/*/**"],
            "message": "import a package by its name and an entry its package.json exports, never its files by path"
          }
        ]
      }
    ],
    // the package boundaries: a package imports only the packages below it, by name, and
    // production code imports no test support
    "zgeoff/import-zones": [
      "error",
      {
        "zones": {
          "packages": ["packages/**"],
          "shared": ["packages/shared/**"],
          "agent-protocol": ["packages/agent-protocol/**"],
          "client": ["packages/client/**"],
          "above-client": ["packages/{mcp,cli,daemon,dashboard}/**"],
          "test-utils": ["packages/test-utils/**"],
          "runtime-neutral": ["packages/{shared,agent-protocol,api,client}/**"],
          // the daemon's own test helpers build queries against real databases
          "db": ["packages/daemon/src/platform/db/**", "packages/daemon/testing/**"],
          "tests": [
            "**/*.{test,e2e}.{ts,tsx}",
            "**/{test-utils,smoke,mocks}/**",
            "packages/daemon/testing/**",
            // impd's harness, published for the tests of code that drives impd
            "packages/testing/**",
            // the end-to-end harness that the suites in e2e/ run on
            "packages/e2e-harness/**",
            "packages/dashboard/e2e/**",
            "**/test-setup.ts"
          ],
          // impd's layers from the bottom up, and the composition root's files above them all
          "daemon-src": ["packages/daemon/src/**"],
          "daemon-root": ["packages/daemon/src/*.ts"],
          // the version that the system routes and the MCP endpoint report
          "daemon-manifest": ["packages/daemon/package.json"],
          "daemon-platform": ["packages/daemon/src/platform/**"],
          "daemon-host-net": ["packages/daemon/src/host-net/**"],
          "daemon-vm": ["packages/daemon/src/vm/**"],
          "daemon-imps": ["packages/daemon/src/imps/**"],
          "daemon-network": ["packages/daemon/src/network/**"],
          "daemon-identity": ["packages/daemon/src/identity/**"],
          "daemon-imp-ops": ["packages/daemon/src/imp-ops/**"],
          "daemon-surface": ["packages/daemon/src/surface/**"],
          // the vm layer's folders from the bottom up, with vm-config.ts at the bottom
          "daemon-vm-config": ["packages/daemon/src/vm/*.ts"],
          "daemon-vm-files": ["packages/daemon/src/vm/files/**"],
          "daemon-vm-imps-contract": ["packages/daemon/src/vm/imps-contract/**"],
          "daemon-vm-storage": ["packages/daemon/src/vm/storage/**"],
          "daemon-vm-agent-client": ["packages/daemon/src/vm/agent-client/**"],
          "daemon-vm-guest-channels": ["packages/daemon/src/vm/guest-channels/**"],
          "daemon-vm-sleep": ["packages/daemon/src/vm/sleep/**"],
          "daemon-vm-vmm": ["packages/daemon/src/vm/vmm/**"],
          "daemon-vm-memory": ["packages/daemon/src/vm/memory/**"],
          "daemon-vm-watchdog": ["packages/daemon/src/vm/watchdog/**"],
          "daemon-vm-templates": ["packages/daemon/src/vm/templates/**"],
          // the broker's folders from the bottom up, with broker-service.ts above them all
          "daemon-broker": ["packages/daemon/src/network/broker/**"],
          "daemon-broker-guest": ["packages/daemon/src/network/broker/guest/**"],
          "daemon-broker-tls": ["packages/daemon/src/network/broker/tls/**"],
          "daemon-broker-secrets": ["packages/daemon/src/network/broker/secrets/**"],
          "daemon-broker-proxy": ["packages/daemon/src/network/broker/proxy/**"],
          "daemon-below-surface": [
            "packages/daemon/src/{platform,host-net,vm,imps,network,identity,imp-ops}/**"
          ]
        },
        "edges": [
          {
            "name": "package-by-name",
            "from": ["packages"],
            "to": ["packages"],
            "allowWithin": "packages/*",
            "reason": "import another package by its package name, never by a relative path"
          },
          {
            "name": "test-support",
            "from": ["packages"],
            "to": ["tests"],
            "ignore": [
              "**/*.{test,e2e}.{ts,tsx}",
              "**/{test-utils,smoke,mocks}/**",
              "packages/daemon/testing/**",
              "packages/testing/**",
              "packages/e2e-harness/**",
              "packages/dashboard/e2e/**",
              "**/test-setup.ts"
            ],
            "reason": "production code never imports test support"
          },
          {
            "name": "daemon-layer-platform",
            "from": ["daemon-platform"],
            "ignore": [
              "**/*.{test,e2e}.{ts,tsx}",
              "**/{test-utils,smoke,mocks}/**",
              "**/test-setup.ts"
            ],
            "allow": ["daemon-platform"],
            "reason": "a daemon layer imports only itself and the layers below it: platform, host-net, vm, imps, network, identity, imp-ops, surface"
          },
          {
            "name": "daemon-layer-host-net",
            "from": ["daemon-host-net"],
            "ignore": [
              "**/*.{test,e2e}.{ts,tsx}",
              "**/{test-utils,smoke,mocks}/**",
              "**/test-setup.ts"
            ],
            "allow": ["daemon-platform", "daemon-host-net"],
            "reason": "a daemon layer imports only itself and the layers below it: platform, host-net, vm, imps, network, identity, imp-ops, surface"
          },
          {
            "name": "daemon-layer-vm",
            "from": ["daemon-vm"],
            "ignore": [
              "**/*.{test,e2e}.{ts,tsx}",
              "**/{test-utils,smoke,mocks}/**",
              "**/test-setup.ts"
            ],
            "allow": ["daemon-platform", "daemon-host-net", "daemon-vm"],
            "reason": "a daemon layer imports only itself and the layers below it: platform, host-net, vm, imps, network, identity, imp-ops, surface"
          },
          {
            "name": "daemon-layer-imps",
            "from": ["daemon-imps"],
            "ignore": [
              "**/*.{test,e2e}.{ts,tsx}",
              "**/{test-utils,smoke,mocks}/**",
              "**/test-setup.ts"
            ],
            "allow": ["daemon-platform", "daemon-host-net", "daemon-vm", "daemon-imps"],
            "reason": "a daemon layer imports only itself and the layers below it: platform, host-net, vm, imps, network, identity, imp-ops, surface"
          },
          {
            "name": "daemon-layer-network",
            "from": ["daemon-network"],
            "ignore": [
              "**/*.{test,e2e}.{ts,tsx}",
              "**/{test-utils,smoke,mocks}/**",
              "**/test-setup.ts"
            ],
            "allow": [
              "daemon-platform",
              "daemon-host-net",
              "daemon-vm",
              "daemon-imps",
              "daemon-network"
            ],
            "reason": "a daemon layer imports only itself and the layers below it: platform, host-net, vm, imps, network, identity, imp-ops, surface"
          },
          {
            "name": "daemon-layer-identity",
            "from": ["daemon-identity"],
            "ignore": [
              "**/*.{test,e2e}.{ts,tsx}",
              "**/{test-utils,smoke,mocks}/**",
