            "allow": ["daemon-vm-config", "daemon-vm-files", "daemon-vm-imps-contract"],
            "reason": "a vm folder imports only itself and the folders below it: vm-config.ts, files, imps-contract, storage, agent-client, guest-channels, sleep, vmm, memory, watchdog, templates"
