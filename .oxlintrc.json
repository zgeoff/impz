              "**/{test-utils,smoke,mocks}/**",
              "**/test-setup.ts"
            ],
            "allow": ["daemon-surface"],
            "reason": "only surface speaks oRPC: a lower layer throws its own error, and surface maps it to an ORPCError"
          },
